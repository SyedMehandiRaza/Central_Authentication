{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand --selectProjects unit db",
    "db:create": "sequelize-cli db:create --charset utf8mb4 --collate utf8mb4_0900_ai_ci",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "migration:new": "sequelize-cli migration:generate --name",
    "seed:new": "sequelize-cli seed:generate --name",
    "test:unit": "jest --selectProjects unit",
    "test:db": "jest --runInBand --selectProjects db",
    "test:migrations": "jest --runInBand --selectProjects migrations"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@app/shared": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  }
}
