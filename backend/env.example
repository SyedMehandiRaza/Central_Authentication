# Copy to backend/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API with cookies. Empty allows none.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (0 when there are none).
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=central_auth
# Must end with _test.
DB_NAME_TEST=central_auth_test

# Two different random values, at least 32 characters each. Generate each one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
