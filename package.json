    "check": "npm test && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  }
}
