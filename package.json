{
  "name": "central-authentication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
